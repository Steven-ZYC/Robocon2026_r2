        <mxCell id="sum1" value="&lt;b&gt;Chassis waypoints&lt;/b&gt;&lt;br&gt;pickup: wp_point_N&lt;br&gt;docking: wp_docking&lt;br&gt;miss: offset → cross → next point&lt;br&gt;&lt;br&gt;&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;IR: /arm/ir_status::ir &gt; 0 (Arduino 2)&lt;br&gt;torque chassis: motor_1 abs_gte 4.0Nm&lt;br&gt;torque arm: motor_5 abs_gt 1.3Nm&lt;br&gt;&lt;br&gt;&lt;b&gt;Timeouts&lt;/b&gt;&lt;br&gt;to_point: timeout_s 2.35-3.5s&lt;br&gt;pickup: ir_timeout_s 2.0s&lt;br&gt;micro_sweep: timeout_s 2.0s" style="text;html=1;strokeColor=#ccc;fillColor=#fafafa;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
