<?xml version="1.0"?>

<robot name="simple_base">

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.7 0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 1.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.7 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="20"/>
      <inertia
        ixx="1" ixy="0" ixz="0"
        iyy="1" iyz="0"
        izz="1"/>
    </inertial>

  </link>

</robot>
