  <version>0.1.0</version>
  <description>Real-time matplotlib visualisation for debugging robot state, driving commands and motor control topics.</description>
  <maintainer email="yanczhang8@gmail.com">Steven Zhang Yancheng</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
