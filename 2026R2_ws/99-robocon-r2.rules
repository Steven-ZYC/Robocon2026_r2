# Robocon R2 — 固定 USB 串口设备名
# 安装: sudo cp 99-robocon-r2.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger

# 气动 Arduino (CH340 USB-Serial, 无唯一序列号)
SUBSYSTEM=="tty", DRIVERS=="ch341", SYMLINK+="pneu_arduino"

# 大喵 USB-CAN 适配器 (HDSC CDC, SN=00000000050C)
SUBSYSTEM=="tty", ENV{ID_USB_SERIAL_SHORT}=="00000000050C", SYMLINK+="damiao_can"

# 传感器 Arduino (Mega 2560 R3, IMU+Encoder, SN=55838323935351014241)
SUBSYSTEM=="tty", ENV{ID_USB_SERIAL_SHORT}=="55838323935351014241", SYMLINK+="sensor_arduino"
